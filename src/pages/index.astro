---
/**
 * Landing "Mở khoá The Magic": màn hình game pixel vàng theo poster "Tôi là một thỏi nam châm hút tiền".
 * Mục tiêu duy nhất: dẫn người đọc tới mục lục ebook The Magic.
 * URL mục lục: THE_MAGIC_INDEX_URL trong src/config/site.ts (mọi nút dùng chung qua <Cta>).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { THE_MAGIC_INDEX_URL, site } from '../config/site';
import { url } from '../lib/url';

const indexUrl = THE_MAGIC_INDEX_URL;

const powerUps = [
  { icon: 'coin', title: '28 màn chơi', text: 'Mỗi ngày một bài thực hành có sẵn' },
  { icon: 'gem', title: '15 phút mỗi ngày', text: 'Làm được ở bất cứ đâu' },
  { icon: 'crown', title: 'Chơi theo nhịp bạn', text: 'Lỡ một ngày? Chơi tiếp màn sau' },
];

// Đồng xu và kim cương lơ lửng quanh màn hình (ít, chỉ để trang trí).
const loot = [
  { k: 'coin', x: 6, y: 22, s: 38, d: 0 },
  { k: 'gem', x: 92, y: 16, s: 34, d: 0.8 },
  { k: 'coin', x: 88, y: 70, s: 30, d: 1.6 },
  { k: 'gem', x: 4, y: 78, s: 28, d: 2.2 },
];

const posterSrcset = `${url('images/manifest-poster-600.webp')} 600w, ${url('images/manifest-poster.webp')} 900w`;
const posterSizes = '(min-width: 861px) 380px, 92vw';
---

<BaseLayout title="Mở khoá The Magic">
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <linearGradient id="gold" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff3a0"></stop><stop offset=".5" stop-color="#ffc21a"></stop><stop offset="1" stop-color="#d97a00"></stop>
      </linearGradient>
      <linearGradient id="ice" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ffffff"></stop><stop offset=".45" stop-color="#7fd8ff"></stop><stop offset="1" stop-color="#1f7ae0"></stop>
      </linearGradient>
      <symbol id="i-coin" viewBox="0 0 32 32">
        <circle cx="16" cy="16" r="14" fill="url(#gold)" stroke="#7a3d00" stroke-width="2.5"></circle>
        <circle cx="16" cy="16" r="9.5" fill="none" stroke="#b86200" stroke-width="1.6"></circle>
        <path d="M13 11h6M16 9v14M13 21h6" stroke="#9a4f00" stroke-width="2.2" stroke-linecap="square"></path>
      </symbol>
      <symbol id="i-gem" viewBox="0 0 32 32">
        <path d="M8 5h16l6 8-14 16L2 13z" fill="url(#ice)" stroke="#0b3a8c" stroke-width="2" stroke-linejoin="round"></path>
        <path d="M2 13h28M11 5l-3 8 8 16 8-16-3-8M16 5l-5 8M16 5l5 8" fill="none" stroke="#0b3a8c" stroke-width="1.1" opacity=".6"></path>
        <path d="M9 7h5l-3 4z" fill="#fff" opacity=".85"></path>
      </symbol>
      <symbol id="i-crown" viewBox="0 0 32 32">
        <path d="M3 10l7 6 6-10 6 10 7-6-3 16H6z" fill="url(#gold)" stroke="#7a3d00" stroke-width="2" stroke-linejoin="round"></path>
        <circle cx="16" cy="19" r="2.4" fill="#e0245e"></circle><circle cx="9.5" cy="20" r="1.6" fill="#29a8ff"></circle><circle cx="22.5" cy="20" r="1.6" fill="#29a8ff"></circle>
      </symbol>
      <symbol id="i-heart" viewBox="0 0 14 12" shape-rendering="crispEdges">
        <path d="M2 0h3v1h1v1h2V1h1V0h3v1h1v1h1v4h-1v1h-1v1h-1v1h-1v1H9v1H8v1H6v-1H5V9H4V8H3V7H2V6H1V2h1V1h0z" fill="#ff3a4f" stroke="#7a0016" stroke-width=".6"></path>
        <path d="M3 2h2v1H3z" fill="#fff" opacity=".9"></path>
      </symbol>
    </defs>
  </svg>

  <div class="game">
    <div class="rays" aria-hidden="true"></div>

    <!-- Cảnh bãi biển pixel (trang trí): trên thoáng (mây, mặt trời), dưới là biển + cát. -->
    <div class="scene" aria-hidden="true">
      <svg class="sun" viewBox="0 0 24 24" shape-rendering="crispEdges">
        <path fill="#ffc21a" d="M11 0h2v3h-2zM11 21h2v3h-2zM0 11h3v2H0zM21 11h3v2h-3zM3 3h2v2H3zM19 3h2v2h-2zM3 19h2v2H3zM19 19h2v2h-2z"></path>
        <path fill="#ffe14a" d="M8 4h8v2h2v2h2v8h-2v2h-2v2H8v-2H6v-2H4V8h2V6h2z"></path>
        <path fill="#fff6b0" d="M8 7h4v2h-2v2H8z"></path>
      </svg>
      {
        [1, 2, 3].map((n) => (
          <svg class={`cloud c${n}`} viewBox="0 0 32 14" shape-rendering="crispEdges">
            <path fill="#ffffff" d="M10 3h8V2h6v2h2v2h2v2h2v2h2v3H0v-3h2V8h2V6h4V4h2z" />
            <path fill="#d6f0ff" d="M0 12h32v1H0zM24 9h4v1h-4z" />
          </svg>
        ))
      }

      <div class="beach">
        <svg class="beach-ground" width="100%" height="100%">
          <defs>
            <pattern id="p-sea" width="48" height="18" patternUnits="userSpaceOnUse">
              <rect width="48" height="18" fill="#1ea4dc"></rect>
              <rect y="6" width="48" height="3" fill="#178cc6"></rect>
              <rect y="14" width="48" height="3" fill="#178cc6"></rect>
              <rect x="4" y="2" width="6" height="2" fill="#bff0ff"></rect>
              <rect x="28" y="10" width="8" height="2" fill="#bff0ff"></rect>
              <rect x="40" y="3" width="4" height="2" fill="#ffffff"></rect>
            </pattern>
            <pattern id="p-foam" width="24" height="8" patternUnits="userSpaceOnUse">
              <rect width="8" height="4" fill="#ffffff"></rect>
              <rect x="8" y="3" width="8" height="4" fill="#ffffff"></rect>
              <rect x="16" width="8" height="4" fill="#ffffff"></rect>
            </pattern>
            <pattern id="p-sand" width="24" height="24" patternUnits="userSpaceOnUse">
              <rect width="24" height="24" fill="#ffd666"></rect>
              <rect x="3" y="4" width="2" height="2" fill="#f2bd3e"></rect>
              <rect x="15" y="9" width="2" height="2" fill="#f2bd3e"></rect>
              <rect x="8" y="17" width="2" height="2" fill="#fff0b0"></rect>
              <rect x="19" y="20" width="2" height="2" fill="#e8ad2e"></rect>
            </pattern>
          </defs>
          <rect width="100%" height="4" fill="#9be3ff"></rect>
          <g class="sea"><rect x="-48" y="4" width="200%" height="60" fill="url(#p-sea)"></rect></g>
          <rect y="62" width="100%" height="8" fill="url(#p-foam)"></rect>
          <rect y="68" width="100%" height="100%" fill="url(#p-sand)"></rect>
          <rect y="68" width="100%" height="5" fill="#f0c050"></rect>
        </svg>

        {
          ['left', 'right'].map((side) => (
            <svg class={`palm palm-${side}`} viewBox="0 0 24 40" shape-rendering="crispEdges">
              <path fill="#8a4b14" d="M11 14h3v6h-3zM12 20h3v6h-3zM12 26h3v7h-3zM11 33h3v7h-3z" />
              <path fill="#c27a2c" d="M11 14h1v6h-1zM12 20h1v6h-1zM12 26h1v7h-1zM11 33h1v7h-1z" />
              <path
                fill="#1f8a3a"
                d="M1 13h2v2H1zM3 11h2v2H3zM5 9h2v2H5zM7 8h4v2H7zM21 13h2v2h-2zM19 11h2v2h-2zM17 9h2v2h-2zM13 8h4v2h-4zM11 6h2v3h-2zM12 4h3v2h-3zM14 3h3v2h-3zM8 11h2v2H8zM6 13h2v2H6zM5 15h2v2H5zM14 11h2v2h-2zM16 13h2v2h-2zM17 15h2v2h-2z"
              />
              <path fill="#4cc85e" d="M2 12h2v1H2zM4 10h2v1H4zM6 8h2v1H6zM20 12h2v1h-2zM18 10h2v1h-2zM16 8h2v1h-2zM13 3h3v1h-3z" />
              <path fill="#5a2e0c" d="M10 12h2v2h-2zM13 12h2v2h-2z" />
            </svg>
          ))
        }
        <svg class="chest" viewBox="0 0 20 16" shape-rendering="crispEdges">
          <path fill="#ffd34e" d="M3 1h3v2H3zM7 0h3v2H7zM12 1h3v2h-3z" />
          <path fill="#a85d1c" d="M2 3h16v5H2z" />
          <path fill="#8a4b14" d="M1 8h18v7H1z" />
          <path fill="#ffc21a" d="M1 7h18v1H1zM9 3h2v12H9z" />
          <path fill="#fff3a0" d="M9 9h2v2H9z" />
          <path fill="#5a2e0c" d="M1 15h18v1H1z" />
        </svg>
        <svg class="coins" viewBox="0 0 16 10" shape-rendering="crispEdges">
          <path fill="#d98a00" d="M0 8h16v2H0zM2 5h12v3H2zM5 2h7v3H5z" />
          <path fill="#ffd34e" d="M0 8h14v1H0zM2 5h10v1H2zM5 2h5v1H5zM7 0h3v2H7z" />
          <path fill="#fff6b0" d="M3 5h2v1H3zM6 2h2v1H6zM1 8h2v1H1z" />
        </svg>
      </div>
    </div>
    <div class="loot" aria-hidden="true">
      {
        loot.map((l) => (
          <svg style={`left:${l.x}%;top:${l.y}%;width:${l.s}px;height:${l.s}px;--d:${l.d}s`}>
            <use href={`#i-${l.k}`} />
          </svg>
        ))
      }
    </div>

    <header class="hud">
      <a class="player" href={url()} aria-label={`${site.plate}, về đầu trang`}>
        <img src={url(site.avatar)} alt="" width="48" height="48" />
        <span>
          <span class="plate">{site.plate}</span>
          <span class="hearts" aria-hidden="true">
            {Array.from({ length: 5 }, () => <svg><use href="#i-heart" /></svg>)}
          </span>
        </span>
      </a>
      <p class="stats" aria-label="28 ngày, lòng biết ơn không giới hạn">
        <span><svg aria-hidden="true"><use href="#i-coin" /></svg> × 28 NGÀY</span>
        <span><svg aria-hidden="true"><use href="#i-gem" /></svg> × ∞ BIẾT ƠN</span>
      </p>
      <p class="level" aria-hidden="true"><svg><use href="#i-crown" /></svg> LV.999</p>
    </header>

    <main id="main" class="arena" tabindex="-1">
      <section class="quest" aria-labelledby="quest-title">
        <p class="tag">★ Nhiệm vụ mới đã mở ★</p>
        <h1 id="quest-title">
          <span class="line l1">
            <span class="t3d gold t1" data-text="Mở khoá">Mở khoá</span>
            <i class="spark s1" aria-hidden="true"></i>
          </span>
          <span class="line l2">
            <span class="t3d blue t2" data-text="The Magic">The Magic</span>
            <i class="spark s2" aria-hidden="true"></i>
            <i class="spark s3" aria-hidden="true"></i>
          </span>
        </h1>

        <div class="quest-body">
          <Cta class="book" aria-label="Mở mục lục The Magic" data-cta>
            <img
              src={url('images/the-magic-book-cover-img.webp')}
              alt="Bìa sách The Magic của Rhonda Byrne"
              width="449"
              height="641"
              decoding="async"
            />
            <span class="shine" aria-hidden="true"></span>
          </Cta>

          <div class="copy">
            <p class="hook">
              Thực hành <strong>15 phút mỗi ngày</strong>, <strong>may mắn, rất nhiều tiền, một cuộc đời thịnh vượng,
              cơ hội, phước lành</strong> sẽ tràn vào cuộc đời bạn một cách ồ ạt!!!
            </p>
            <p class="dare">Không tin à? Thử đi :-)</p>
          </div>
        </div>

        <ul class="powerups">
          {
            powerUps.map((p) => (
              <li>
                <svg aria-hidden="true">
                  <use href={`#i-${p.icon}`} />
                </svg>
                <span>
                  <strong>{p.title}</strong>
                  {p.text}
                </span>
              </li>
            ))
          }
        </ul>

        <Cta class="start" data-cta data-hero-cta>
          <span class="play" aria-hidden="true">▶</span>
          <span>Bắt đầu đưa phép màu vào cuộc đời bạn&nbsp;!!!</span>
        </Cta>
        <p class="fine">
          {indexUrl ? 'Mở mục lục The Magic · Chọn phần bạn muốn đọc.' : 'Mục lục ebook The Magic đang được chuẩn bị.'}
        </p>
      </section>

      <figure class="poster">
        <picture>
          <source type="image/webp" srcset={posterSrcset} sizes={posterSizes} />
          <img
            src={url('images/manifest-poster.png')}
            width="941"
            height="1672"
            decoding="async"
            alt="Poster phong cách game pixel: chàng trai đeo kính râm giơ nam châm giữa bãi biển nhiệt đới, xung quanh là đồng vàng và kim cương, kèm dòng chữ “Tôi là một thỏi nam châm hút tiền.”"
          />
        </picture>
      </figure>
    </main>

    <footer class="foot">
      <p class="foot-line">Mỗi hành trình đều bắt đầu bằng một bước nhỏ.</p>
      <p class="foot-small">Website chia sẻ độc lập. The Magic là tác phẩm của Rhonda Byrne.</p>
    </footer>
  </div>

  <!-- Thanh đọc cố định trên điện thoại: chỉ hiện khi nút START đã cuộn khỏi màn hình. -->
  <div class="readbar" data-readbar>
    <span class="readbar-label">The Magic</span>
    <Cta class="readbar-btn" data-cta>▶ Mở mục lục</Cta>
  </div>

  <!-- Thông báo khi chưa có URL mục lục. -->
  {
    !indexUrl && (
      <div class="toast" role="status" aria-live="polite" data-toast hidden>
        <p>Mục lục The Magic đang được chuẩn bị. Bạn quay lại sau nhé.</p>
        <button type="button" class="toast-close" data-toast-close aria-label="Đóng thông báo">
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    )
  }
</BaseLayout>

<script>
  // Thanh đọc cố định: hiện khi nút START đã khuất phía trên màn hình.
  const bar = document.querySelector<HTMLElement>('[data-readbar]');
  const start = document.querySelector('[data-hero-cta]');
  if (bar && start && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      bar.classList.toggle('is-on', !e!.isIntersecting && e!.boundingClientRect.bottom < 0);
    }).observe(start);
  }

  // Chưa có URL mục lục: nhấn nút thì hiện thông báo nhỏ, đóng được, tự ẩn sau vài giây.
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  if (toast) {
    let timer = 0;
    const hide = () => {
      toast.classList.remove('is-on');
      window.setTimeout(() => (toast.hidden = true), 200);
    };
    const show = () => {
      window.clearTimeout(timer);
      toast.hidden = false;
      requestAnimationFrame(() => toast.classList.add('is-on'));
      timer = window.setTimeout(hide, 6000);
    };
    document.querySelectorAll('[data-pending]').forEach((btn) => btn.addEventListener('click', show));
    toast.querySelector('[data-toast-close]')?.addEventListener('click', hide);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !toast.hidden) hide();
    });
  }
</script>

<style>
  :global(body) {
    background: #2b8cf0;
  }
  .game {
    --ink: #2a1400;
    --gold: #ffc21a;
    --gold-hi: #fff3a0;
    --deep: #7a3d00;
    --blue: #1f7ae0;
    --display: 'Bungee', 'Be Vietnam Pro', system-ui, sans-serif;
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    color: var(--ink);
    padding: 0 clamp(0.75rem, 3vw, 2rem) 1.5rem;
    /* Trời: xanh đậm trên đỉnh, nhạt dần về đường chân trời (biển + cát vẽ ở .beach). */
    background: linear-gradient(180deg, #2b8cf0 0%, #5cb8ff 35%, #a9e2ff 75%, #c9eeff 100%);
  }

  /* ---------- Cảnh bãi biển pixel ---------- */
  .scene {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .scene svg {
    position: absolute;
    image-rendering: pixelated;
  }
  .sun {
    top: 5.5rem;
    right: 3%;
    width: clamp(56px, 7vw, 96px);
    filter: drop-shadow(0 0 18px rgb(255 225 74 / 0.75));
  }
  .cloud {
    width: clamp(90px, 11vw, 170px);
    opacity: 0.95;
  }
  .c1 {
    top: 9rem;
    left: 2%;
  }
  .c2 {
    top: 4.2rem;
    left: 44%;
    width: clamp(70px, 8vw, 120px);
    opacity: 0.85;
  }
  .c3 {
    top: 15rem;
    right: 1%;
    width: clamp(80px, 9vw, 140px);
  }
  .beach {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 230px;
  }
  .beach .beach-ground {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: auto;
  }
  .palm {
    bottom: 34px;
    width: clamp(90px, 10vw, 140px);
  }
  .palm-left {
    left: -12px;
  }
  .palm-right {
    right: -12px;
    scale: -1 1;
  }
  .chest {
    bottom: 26px;
    right: clamp(90px, 12vw, 170px);
    width: clamp(44px, 4.5vw, 64px);
  }
  .coins {
    bottom: 22px;
    left: clamp(96px, 12vw, 170px);
    width: clamp(36px, 3.5vw, 52px);
  }
  /* Tia sáng toả từ giữa như phía sau dòng chữ trên poster. */
  .rays {
    position: absolute;
    left: 50%;
    top: 46%;
    width: 180vmax;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: repeating-conic-gradient(from 0deg, rgb(255 246 190 / 0.32) 0deg 7deg, transparent 7deg 18deg);
    mask: radial-gradient(circle, #000 0%, rgb(0 0 0 / 0.6) 25%, transparent 55%);
    pointer-events: none;
  }
  .loot svg {
    position: absolute;
    filter: drop-shadow(0 3px 0 rgb(0 0 0 / 0.25));
    pointer-events: none;
  }

  /* ---------- HUD ---------- */
  .hud {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    padding: 0.9rem 0 0.5rem;
  }
  .hud p {
    margin: 0;
  }
  .player {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .player:focus-visible {
    outline: 3px solid #fff;
  }
  .player img {
    width: 48px;
    height: 48px;
    image-rendering: pixelated;
    border: 3px solid var(--ink);
    border-radius: 6px;
    box-shadow: 0 3px 0 var(--ink);
  }
  .plate {
    display: block;
    margin-bottom: 0.2rem;
    font: 400 0.82rem/1.3 var(--display);
    color: var(--gold-hi);
    background: linear-gradient(180deg, #5a2a00, #2a1400);
    border: 2px solid var(--gold);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    text-shadow: 0 2px 0 #000;
  }
  .hearts {
    display: flex;
    gap: 3px;
  }
  .hearts svg {
    width: 20px;
    height: 17px;
  }
  .stats {
    display: flex;
    gap: 1rem;
  }
  .stats span,
  .level {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font: 400 0.95rem var(--display);
    color: #fff;
    text-shadow:
      2px 2px 0 var(--ink),
      -1px -1px 0 var(--ink),
      1px -1px 0 var(--ink),
      -1px 1px 0 var(--ink);
  }
  .stats svg,
  .level svg {
    width: 26px;
    height: 26px;
  }
  .level {
    font-size: 1.15rem;
    color: var(--gold-hi);
  }
  .level span {
    font-size: 0.8rem;
    color: #fff;
  }

  /* ---------- Khu vực chính ---------- */
  .arena {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 380px);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    padding-top: 0.5rem;
  }
  .arena:focus {
    outline: none;
  }
  .quest {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #fffbe6, #fff0c2);
